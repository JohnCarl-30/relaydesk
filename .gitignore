# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rewritten by next dev; keep them out of git
AGENTS.md
CLAUDE.md

# huggingface transformers.js model cache
.cache/

# live OpenTelemetry dump; committed samples live in eval/traces/*.json
eval/traces/live.jsonl
eval/.norewrite.jsonl
eval/.rewrite.jsonl
eval/.extractive.jsonl
eval/.generate.jsonl

# local browser dumps from Cursor
.playwright-cli/

# playwright
/test-results/
/playwright-report/
/blob-report/
