# Required for LLM answers. Without it, Relaydesk cites help articles extractively.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Walk generate → rewrite without a key (eval/trace-conversation.ts).
# RELAYDESK_STUB_LLM=1
# RELAYDESK_TRACE_FILE=eval/traces/live.jsonl
# RELAYDESK_TRACE_FILE=0

# Langfuse. With both keys set, every relaydesk span is also sent to Langfuse.
# Model calls show up as generations, and a chat's turns share one session.
# Emails, phone numbers, and card numbers are redacted before any span is exported.
# Base URL defaults to the EU region; US is https://us.cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# SQLite file. Defaults to data/relaydesk.db; e2e runs point this at a temp file.
# RELAYDESK_DB_PATH=data/relaydesk.db

# Password for the Nimbus demo staff login, staff@nimbus.demo (demo default)
RELAYDESK_ADMIN_PASSWORD=nimbus-demo

# With this set, /signup asks for the code, so only people you give it to can create a business.
# RELAYDESK_SIGNUP_CODE=

# The public address, for embed snippets and invite links. Defaults to the request's host.
# RELAYDESK_PUBLIC_URL=https://help.example.com

# MCP token for the Nimbus demo inbox at /api/mcp. Businesses make their own on the Setup page.
# RELAYDESK_MCP_TOKEN=

# Signs staff session cookies. Without it, one is generated into the database on first use.
# Changing it signs every staff member out.
# RELAYDESK_SESSION_SECRET=
