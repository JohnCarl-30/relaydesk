# Required for LLM answers. Without it, Relaydesk cites help articles extractively.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Walk generate → rewrite without a key (eval/trace-conversation.ts).
# RELAYDESK_STUB_LLM=1
# RELAYDESK_TRACE_FILE=eval/traces/live.jsonl
# RELAYDESK_TRACE_FILE=0

# Admin inbox password (demo default)
RELAYDESK_ADMIN_PASSWORD=nimbus-demo
