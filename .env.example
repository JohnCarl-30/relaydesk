# Copy to .env.local for `npm run dev`, or to .env.docker for `docker compose up`.
# Required for LLM answers. Without it, Relaydesk cites help articles extractively.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Walk generate → rewrite without a key (eval/trace-conversation.ts).
# RELAYDESK_STUB_LLM=1
# RELAYDESK_TRACE_FILE=eval/traces/live.jsonl
# RELAYDESK_TRACE_FILE=0

# Langfuse. With both keys set, every relaydesk span is also sent to Langfuse.
# Model calls show up as generations, and a chat's turns share one session.
# Emails, phone numbers, and card numbers are redacted before any span is exported.
# Base URL defaults to the EU region; US is https://us.cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ElevenLabs. With a key, each business can switch its widget's voice to ElevenLabs under
# Setup → Voice: Scribe hears the question and an ElevenLabs voice reads the answer.
# The browser's own voice stays the default, and the fallback when a call fails.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDqDCyKwW   # any voice id from your ElevenLabs voice library
# ELEVENLABS_MODEL=eleven_flash_v2_5        # fast and multilingual; eleven_v4_turbo is more expressive
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Monthly ElevenLabs minutes per business, speech in and out together. Then the browser's voice.
# RELAYDESK_VOICE_MINUTES=300

# SQLite file. Defaults to data/relaydesk.db; e2e runs point this at a temp file.
# RELAYDESK_DB_PATH=data/relaydesk.db

# Password for the Nimbus demo staff login, staff@nimbus.demo (demo default)
RELAYDESK_ADMIN_PASSWORD=nimbus-demo

# With this set, /signup asks for the code, so only people you give it to can create a business.
# RELAYDESK_SIGNUP_CODE=

# The public address, for embed snippets and invite links. Defaults to the request's host.
# RELAYDESK_PUBLIC_URL=https://help.example.com

# MCP token for the Nimbus demo inbox at /api/mcp. Businesses make their own on the Setup page.
# RELAYDESK_MCP_TOKEN=

# Signs staff session cookies. Without it, one is generated into the database on first use.
# Changing it signs every staff member out.
# RELAYDESK_SESSION_SECRET=

# Backups (the `backup` service in docker-compose.yml). Snapshots always go to /data/backups.
# RELAYDESK_BACKUP_AT=18:00          # daily, HH:MM UTC; 18:00 UTC is 02:00 in Manila
# RELAYDESK_BACKUP_KEEP=7            # snapshots kept on disk
# Optional off-server copy to any S3-compatible bucket (Cloudflare R2, Backblaze B2, ...).
# Keep old copies with the bucket's lifecycle rule, e.g. delete after 30 days.
# RELAYDESK_BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# RELAYDESK_BACKUP_S3_BUCKET=relaydesk-backups
# RELAYDESK_BACKUP_S3_ACCESS_KEY_ID=
# RELAYDESK_BACKUP_S3_SECRET_ACCESS_KEY=
# RELAYDESK_BACKUP_S3_REGION=auto

# Cloudflare Tunnel (docker compose --profile tunnel). From Zero Trust → Networks → Tunnels.
# TUNNEL_TOKEN=
